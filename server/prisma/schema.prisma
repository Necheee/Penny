datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// User Model: Differentiates business owner admin from regular customers
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String?
  phone        String?
  role         String    @default("customer") // "admin" | "customer"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  orders       Order[]
}

// Category Model: Tops, Bottoms, Sets, Outerwear, etc.
model Category {
  id           String    @id @default(uuid())
  slug         String    @unique
  name         String
  displayOrder Int       @default(0)
  subcategories Json     @default("[]")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  products     Product[]

  @@map("categories")
}

// Product Model: Capsule wardrobe pieces
model Product {
  id           String         @id @default(uuid())
  slug         String         @unique
  name         String
  price        Decimal        @db.Decimal(12, 2)
  description  String?
  material     String?        @default("100% Cotton")
  fit          String?        @default("Relaxed fit")
  care         String?        @default("Machine wash cold.")
  shippingInfo String?        @default("Free delivery on orders above ₦200,000.") @map("shipping")
  featured     Boolean        @default(false)
  inStock      Boolean        @default(true) @map("in_stock")
  status       ProductStatus  @default(DRAFT)
  categoryId   String         @map("category")
  category     Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  legacyImages Json?          @map("images")
  legacyColors Json?          @map("colors")
  legacySizes  Json?          @map("available_sizes")
  images       ProductImage[]
  variants     ProductVariant[]
  inventoryAdjustments InventoryAdjustment[]
  orderItems   OrderItem[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@map("products")
}

// ProductImage Model: Primary image and gallery photos
model ProductImage {
  id        String   @id @default(uuid())
  url       String
  publicId  String?  @map("public_id") // Cloudinary asset ID
  isPrimary Boolean  @default(false) @map("is_primary")
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("product_images")
}

// ProductVariant Model: Size, color, and inventory SKU
model ProductVariant {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryAdjustments InventoryAdjustment[]
  orderItems    OrderItem[]
  size          String   // "XS", "S", "M", "L", "XL", "XXL"
  colorName     String   @map("color_name") // e.g. "Charcoal", "Cream", "Olive"
  colorHex      String?  @map("color_hex") // e.g. "#36454f"
  stockQuantity Int       @default(10) @map("stock_quantity")
  sku           String?  @unique
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([productId, size, colorName])
  @@map("product_variants")
}

// SizeGuide Model: Centimeter (CM) and Inch measurements per garment type
model SizeGuide {
  id           String   @id @default(uuid())
  category     String   @unique // "tops" | "bottoms"
  measurements String   // JSON string of measurement rows
  updatedAt    DateTime @updatedAt
}

// Order Model: Customer purchase transactions
model Order {
  id              String      @id @default(uuid())
  orderRef        String      @unique @map("reference") // e.g. "PNY-892140"
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName    String      @map("customer")
  customerEmail   String      @map("email")
  customerPhone   String      @map("phone")
  shippingAddress String      @map("address")
  shippingState   String      @map("state")
  subtotal        Decimal     @db.Decimal(12, 2)
  deliveryFee     Decimal     @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  status          String      @default("Processing") // "Processing" | "Shipped" | "Delivered" | "Cancelled"
  paymentStatus   String      @default("Pending") @map("payment_status") // "Pending" | "Paid" | "Failed"
  paymentMethod   String      @default("Paystack") @map("payment_method")
  paymentRef      String?     @map("payment_ref")
  items           OrderItem[]
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@map("orders")
}

// OrderItem Model: Line items within an order
model OrderItem {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?  @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?  @map("variant_id")
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name      String
  size      String
  color     String
  quantity  Int      @default(1)
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  imageUrl  String?  @map("image_url")

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model InventoryAdjustment {
  id            String         @id @default(uuid())
  variantId     String         @map("variant_id")
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productId     String         @map("product_id")
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityDelta Int            @map("quantity_delta")
  reason        String
  reference     String?
  actorId       String?        @map("actor_id")
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([variantId, createdAt])
  @@map("inventory_adjustments")
}
