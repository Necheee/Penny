# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Strictly Single-Owner Administrator Credentials
ADMIN_EMAIL=owner@penny.com
ADMIN_PASSWORD=your_secure_password_here
ADMIN_NAME="PENNY Owner"

# Database Connection (Supabase / Neon PostgreSQL for cross-device access)
# Example: DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB]?sslmode=require"
DATABASE_URL="file:./dev.db"

# Transactional Email System (Nodemailer / Gmail App Password / Resend / SendGrid)
# If left empty, automated test inbox (Ethereal) generates live preview links automatically
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PENNY Support <support@penny.com>"
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Cloud Media Storage: Cloudflare R2 (Preferred - Zero Egress Fees & Auto Compression)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Cloud Media Storage: Cloudinary (Secondary Fallback)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack Payment Gateway (Phase 14)
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here

